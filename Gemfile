source "https://rubygems.org"

# Plain Jekyll 4.x for local development.
# GitHub Pages builds the site server-side with its own pinned toolchain,
# so this Gemfile only needs to satisfy local `bundle exec jekyll serve`.
gem "jekyll", "~> 4.3"
gem "webrick"

# Bundled-gems removed from Ruby's default set in 3.4+ but still pulled in
# by the Jekyll dependency tree.
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
